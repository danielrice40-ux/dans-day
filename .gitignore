# ---- Secrets and keys -------------------------------------------------
# NEVER commit these. The app stores everything in the browser, so it
# needs no keys at all - this list is here to keep accidents out.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
secrets.json

# ---- Dependencies -----------------------------------------------------
# There is no build step, but this keeps the repo clean if you ever add one.
node_modules/
bower_components/
vendor/

# ---- Logs and temporary files ----------------------------------------
*.log
npm-debug.log*
yarn-error.log*
*.tmp

# ---- OS junk ----------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---- Editor junk ------------------------------------------------------
.vscode/
.idea/
*.swp
*~
